# Backend API base URL (must include /api/v1) and Socket.IO origin.
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time — read
# via src/constants/config.js. Never put secrets here, only the values
# the client legitimately needs (backend/API secrets stay server-side).
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_SOCKET_URL="http://localhost:4000"

# Only needed for production app-store builds (react-native-maps config
# plugin) — Expo Go renders maps without these during development.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

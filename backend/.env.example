# Database
DATABASE_URL="postgresql://fleet:fleet_dev_password@localhost:5432/fleet_management?schema=public"

# Auth
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:19006"

# Redis / background jobs
REDIS_URL="redis://localhost:6379"

# Outbound email (password reset, etc.) — leave SMTP_HOST empty in dev to
# log emails instead of sending them; see src/services/mailService.js
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fleet Management <no-reply@fleetmanagement.test>"
APP_WEB_URL="http://localhost:19006"

# File storage (see src/services/storageService.js — provider is swappable)
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Maps / location
GOOGLE_MAPS_API_KEY=

# Push notifications (Expo)
PUSH_NOTIFICATION_KEY=
